rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function canAccess(userId) {
      return request.auth != null && (
        request.auth.uid == userId ||
        userId.matches('^key_[a-f0-9]{64}$')
      );
    }

    match /users/{uid} {
      // users 컬렉션 자체의 목록 조회는 허용하지 않아 고정 사용자 경로 열거를 차단합니다.
      allow get, create, update: if canAccess(uid);
      match /records/{recordId} {
        allow read, write: if canAccess(uid);
      }
    }
  }
}
