rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // QA Emulator 전용 룰 — 운영 룰과 분리. 익명 로그인 + 본인 문서만 허용.
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
      match /records/{recordId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }
  }
}
