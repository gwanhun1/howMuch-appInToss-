# QA 모드 — Firebase Emulator + AIT-Mock 활성화
# 이 파일은 git에 커밋됨 (실 키 아님 / Emulator 더미값)
VITE_QA_MODE=true

# Firebase 더미값 (Emulator는 키 검증 안 함, 단 형식만 맞으면 됨)
VITE_FIREBASE_API_KEY=demo-api-key
VITE_FIREBASE_AUTH_DOMAIN=howmuch-qa.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=howmuch-qa
VITE_FIREBASE_STORAGE_BUCKET=howmuch-qa.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:demo

# Emulator 엔드포인트 — 다른 머신에서 띄울 때 변경
VITE_QA_FIRESTORE_HOST=localhost:8080
VITE_QA_AUTH_HOST=http://localhost:9099
